# Copy to .env and fill in values as needed.
# docker compose reads .env automatically.

# --- Core ---
JWT_SECRET=change-me-in-production
POSTGRES_DB=graphical_editor
POSTGRES_USER=editor
POSTGRES_PASSWORD=editor
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=graphical-editor

# --- OAuth (optional) ---
# Frontend base URL used for OAuth callback redirects.
OAUTH_FRONTEND_BASE_URL=http://localhost:8080

# Google OAuth 2.0 / OpenID Connect
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8080/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Yandex OAuth
# Console: https://oauth.yandex.ru/
# Redirect URI: http://localhost:8080/api/auth/oauth/yandex/callback
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=

# VK ID OAuth
# Console: https://id.vk.com/about/business/go
# Redirect URI: http://localhost:8080/api/auth/oauth/vk/callback
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=

# T-Bank / Tinkoff ID OAuth
# Access/registration may require partner/business approval.
# Redirect URI: http://localhost:8080/api/auth/oauth/tbank/callback
OAUTH_TBANK_CLIENT_ID=
OAUTH_TBANK_CLIENT_SECRET=

# Optional per-provider redirect URI override (leave empty to use default)
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_YANDEX_REDIRECT_URI=
OAUTH_VK_REDIRECT_URI=
OAUTH_TBANK_REDIRECT_URI=
